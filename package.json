{
  "name": "hedera-deploy",
  "version": "1.0.0",
  "description": "Deploy a compiled smart contract to the Hedera Testnet via the Hedera JS SDK and call it.",
  "type": "module",
  "main": "deploy.js",
  "scripts": {
    "deploy": "node deploy.js",
    "call": "node call.js",
    "compile": "npx solcjs --bin --abi -o build Voting.sol",
    "dev": "concurrently \"node server.js\" \"vite --port 5173\"",
    "start": "node server.js"
  },
  "dependencies": {
    "@hashgraph/sdk": "^2.62.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "hashconnect": "^3.0.14",
    "solc": "^0.8.36",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vite": "^5.2.0"
  }
}
